# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_chatbot

# ── Backend ───────────────────────────────────────────────
BACKEND_PORT=8000
ENVIRONMENT=production

JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GEMINI_API_KEY=your-api-key-here
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TITLE_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# ── Embeddings ────────────────────────────────────────────
# Local dev: ollama (keeps the current embeddinggemma workflow)
# Free deployment: gemini (no Ollama container needed on Render)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=embeddinggemma
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=1536
GEMINI_EMBED_BATCH_SIZE=50
GEMINI_EMBED_MAX_RETRIES=3

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@company.com
ADMIN_SEED_PASSWORD=admin123

# Upload / registration guardrails
MAX_UPLOAD_MB=20
ALLOW_PUBLIC_REGISTRATION=true

# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K_CHUNKS=5
# SEMANTIC_CHUNKING_ENABLED=true

# ── Frontend ──────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── CORS (JSON array or comma-separated) ──────────────────
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
